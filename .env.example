# ---------- Backend (api + indexer) ----------
# Inside docker compose the DB host is `postgres`; for local `go run` use localhost.
DATABASE_URL=postgres://tonnet:tonnet@postgres:5432/tonnet?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=info
# json (production) | text (local reading)
LOG_FORMAT=json
# Comma-separated browser origins allowed to call the API (dev server + production domain).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Chain. Only TON is implemented today; internal/chain.Client is where other chains plug in.
TON_NETWORK=testnet
TONAPI_BASE_URL=https://testnet.tonapi.io
# Get a key at https://tonconsole.com — without a key tonapi allows ~1 request/second.
TONAPI_KEY=
TONAPI_RPS=1
# Per-call timeout for chain requests.
CHAIN_CALL_TIMEOUT=15s

# Collections to index (raw `0:hex` or user-friendly), comma-separated. Printed by `npm run deploy:collection`.
COLLECTIONS=

# Marketplace contract (Getgems nft-marketplace-v2) and the Ed25519 seed that authorizes sale deploys.
# Printed by `npm run deploy:marketplace`. NEVER commit the private key.
MARKETPLACE_ADDRESS=
MARKETPLACE_PRIVATE_KEY=
# Where marketplace fees go (defaults to MARKETPLACE_ADDRESS if empty) and the fee in basis points (500 = 5%).
MARKETPLACE_FEE_ADDRESS=
MARKETPLACE_FEE_BPS=500

# Auth: ton_proof domains that are accepted (host[:port] as shown to the wallet), JWT signing secret and TTL.
TON_PROOF_DOMAINS=localhost:5173,localhost:3000
# At least 16 characters.
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=24h

# Indexer cadence: owner reconcile every INDEXER_INTERVAL, full per-item tx scan every ITEM_SCAN_INTERVAL.
INDEXER_INTERVAL=4s
ITEM_SCAN_INTERVAL=60s
# A registered tx that is not confirmed within this window is marked failed.
TX_PENDING_TTL=10m
# A listing that never becomes active (NFT never reached the sale contract) is cancelled after this.
PENDING_LISTING_TTL=15m

# ---------- Web (build-time args for the SPA) ----------
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432
# Empty = same-origin (nginx proxies /api and /ws). Set only when the SPA is hosted apart from the API.
VITE_API_URL=
VITE_TON_NETWORK=testnet

# ---------- Production (docker-compose.prod.yml) ----------
DOMAIN=tonnet.example.com
